<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/configure_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_name"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/edit_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_name"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_url_big"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/edit_url_big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_url"
            android:text="@string/example_url_big"
            android:inputType="textUri" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_browse_big"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/edit_browse_big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_browse"
            android:text="@string/example_browse_big"
            android:inputType="textUri" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_url_small"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/edit_url_small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_url"
            android:text="@string/example_url_small"
            android:inputType="textUri" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_browse_small"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/edit_browse_small"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_browse"
            android:text="@string/example_browse_small"
            android:inputType="textUri" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_url_todo"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/edit_url_todo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_url"
            android:text="@string/example_url_todo"
            android:inputType="textUri" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_browse_todo"
            android:layout_marginTop="8dp" />

        <EditText
            android:id="@+id/edit_browse_todo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_browse"
            android:text="@string/example_browse_todo"
            android:inputType="textUri" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end"
            android:layout_marginTop="24dp">

            <Button
                android:id="@+id/btn_cancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_cancel" />

            <Button
                android:id="@+id/btn_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/btn_add" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_browse_section"
            android:layout_marginTop="24dp" />

        <RadioGroup
            android:id="@+id/browse_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <RadioButton
                android:id="@+id/radio_browse_big"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:text="@string/row_label_big" />

            <RadioButton
                android:id="@+id/radio_browse_small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:text="@string/row_label_small" />

            <RadioButton
                android:id="@+id/radio_browse_todo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/row_label_todo" />

        </RadioGroup>

    </LinearLayout>

</ScrollView>
